# ============================================================
# XAU/USD Price Action Bot — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   nano .env
# ============================================================

# ── VPS / Deployment ─────────────────────────────────────────
# IP address or hostname of the production VPS
VPS_HOST=159.89.110.11

# Absolute path where the bot is installed on the VPS
BOT_DIR=/home/botuser/xau_bot

# ── Data Directories ─────────────────────────────────────────
# These may be absolute or relative to BOT_DIR.
# Defaults (bare names) are resolved relative to BOT_DIR at runtime.
DATA_DIR=/home/botuser/xau_bot/data
LOGS_DIR=/home/botuser/xau_bot/logs
REPORTS_DIR=/home/botuser/xau_bot/reports
BACKUP_DIR=/home/botuser/xau_bot/backups

# ── Wine / MT5 ────────────────────────────────────────────────
# Wine prefix used to run MetaTrader 5 on Linux
WINE_PREFIX=/home/botuser/.wine-mt4

# Path to the MT5 executable inside the Wine prefix
MT5_EXE=/home/botuser/.wine-mt4/drive_c/Program Files/MetaTrader 5/terminal64.exe

# Path where the XAU_Bridge EA writes/reads JSON files
# This is the MQL5/Files directory inside the Wine drive
MT5_FILES_PATH=/home/botuser/.wine-mt4/drive_c/Program Files/MetaTrader 5/MQL5/Files

# ── Bot Configuration ─────────────────────────────────────────
# Operating mode: backtest | paper | live
BOT_MODE=live

# Trading symbol as recognised by your broker in MT5
BOT_SYMBOL=XAUUSD!

# Broker adapter: paper | dwx | metaapi | oanda
BROKER_TYPE=dwx

# DWX magic number — must match the EA's Magic Number setting in MT5
DWX_MAGIC=88888

# ── Network Ports ─────────────────────────────────────────────
# FastAPI backend HTTPS port
API_PORT=8443

# Streamlit UI HTTP port
UI_PORT=8502

# x11vnc raw VNC port (internal — not exposed to public)
VNC_PORT=5900

# noVNC websocket/web port (browser access to MT5 desktop)
VNC_WEB_PORT=6080

# ── SSL / TLS ─────────────────────────────────────────────────
# Domain name for which Let's Encrypt certificates were issued
SSL_DOMAIN=xaubot.aswaqalseyouh.ae

# Directory containing fullchain.pem and privkey.pem
SSL_CERT_DIR=/etc/letsencrypt/live/xaubot.aswaqalseyouh.ae

# ── Backup ────────────────────────────────────────────────────
# Number of days to retain backup archives (older ones are deleted)
BACKUP_RETENTION_DAYS=30

# ── Timezone ──────────────────────────────────────────────────
# IANA timezone for log timestamps and cron scheduling
TZ=Asia/Dubai
