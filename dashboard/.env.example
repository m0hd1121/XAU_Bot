# XAU Control Center — environment variables
# Copy this to .env.local and fill in your values

# FastAPI backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8443

# WebSocket URL override (optional — defaults to ws:// derived from NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=ws://localhost:8443

# Application name shown in the browser tab
NEXT_PUBLIC_APP_NAME=XAU Control Center

# Session / JWT configuration
# Access token TTL in minutes (must match backend config)
NEXT_PUBLIC_TOKEN_TTL_MINUTES=30
