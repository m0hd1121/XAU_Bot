[Unit]
Description=XAU Bot — Agent 1: Strategy Research & Self-Learning
After=network.target xaubot.service
Wants=xaubot.service

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/xau_bot
ExecStart=/home/botuser/xau_bot/.venv/bin/python agents/run_agent.py 1
Restart=always
RestartSec=30
StandardOutput=append:/home/botuser/xau_bot/logs/agent1.log
StandardError=append:/home/botuser/xau_bot/logs/agent1.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
